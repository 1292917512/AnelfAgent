{
  "name": "anelf-webui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/module-links.mjs",
    "build": "tsc -b tsconfig.json tsconfig.tools.json && vite build --outDir dist.next && node scripts/swap-dist.mjs",
    "preview": "vite preview",
    "test:modules": "node --test scripts/module-links.test.mjs scripts/swap-dist.test.mjs",
    "lint": "cd ../.. && node web/frontend/node_modules/eslint/bin/eslint.js web/frontend/src web/frontend/e2e \"entities/*/panel.tsx\" \"entities/*/panels/**/*.{ts,tsx,mts}\" \"channels/*/frontend/**/*.{ts,tsx,mts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretypecheck": "node scripts/module-links.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@tanstack/react-query": "^5.62.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "mpegts.js": "^1.8.0",
    "react": "^18.3.1",
    "react-arborist": "^3.16.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.5",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
