# === Personal data & memory ===
config/memory/
config/config/

# === NoneBot 桥接源码检出（git 源安装的本地仓库，二次开发用） ===
channels/nonebot_bridge/sources/

# === Personal tasks (keep memory_consolidation.json as example) ===
config/tasks/*
!config/tasks/memory_consolidation.json

# === Personal personas (default.json is the template) ===
config/personas/mengli.json
config/personas/yanyi.json

# === Personal character assets ===
config/mengli_aigc/
# Personal runtime event logs (治理事件、心跳日志等)
config/events/

# === Root-level ComfyUI workflow templates (personal downloads) ===
/*_template.json
/*workflow*.json

# === Entity secrets (personal configs stay local; example files unaffected) ===
entities/*/config.json
# Any nested config.json under an entity (e.g. entities/<name>/<name>/...) is also runtime-generated
entities/**/config.json
entities/ssh/connections.json

# === Channel secrets ===
channels/telegram/channel_config.json
channels/qq/channel_config.json
channels/feishu/channel_config.json
channels/weixin/channel_config.json
channels/nonebot_bridge/channel_config.json
# Any nested channel_config.json (e.g. channels/<vendor>/<vendor>/...) is also runtime-generated
channels/**/channel_config.json

# === Secrets backup (generated by scripts/secrets-*.sh) ===
.secrets/

# === Frontend build ===
web/frontend/dist/
web/frontend/node_modules/

# === Build & packaging ===
/build/
/dist/
