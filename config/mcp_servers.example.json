{
  "mcpServers": {
    "example-sse": {
      "url": "http://127.0.0.1:8080/mcp",
      "transport": "sse",
      "enabled": false
    },
    "example-stdio": {
      "command": "npx",
      "args": [
        "-y",
        "@example/mcp-server"
      ],
      "env": {
        "API_KEY": "your-api-key-here"
      },
      "transport": "stdio",
      "enabled": false
    },
    "example-http": {
      "url": "https://mcp.example.com/mcp",
      "transport": "streamable_http",
      "enabled": false,
      "oauth": {
        "scopes": "read write"
      }
    },
    "xiaodu-iot": {
      "command": "npx",
      "args": [
        "-y",
        "dueros-iot-mcp"
      ],
      "env": {
        "ACCESS_TOKEN": "your-dueros-access-token"
      },
      "transport": "stdio",
      "enabled": false,
      "stay_awake": true
    },
    "xiaodu": {
      "url": "https://xiaodu.baidu.com/dueros_mcp_server/mcp/",
      "headers": {
        "ACCESS_TOKEN": "your-dueros-access-token"
      },
      "transport": "streamable_http",
      "enabled": false,
      "stay_awake": true
    }
  }
}
