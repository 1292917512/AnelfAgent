        "type": "object",
        "properties": {
          "done": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gained": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure": {
            "type": "string"
          }
        },
        "required": [
