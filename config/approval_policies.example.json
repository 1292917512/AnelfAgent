{
  "policies": [
    {
      "tool_name_pattern": "run_shell_command",
      "risk_level": "critical",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "Shell 命令执行（高危）"
    },
    {
      "tool_name_pattern": "python_exec",
      "risk_level": "critical",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "Python 代码执行（高危）"
    },
    {
      "tool_name_pattern": "restart_app",
      "risk_level": "critical",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "应用重启"
    },
    {
      "tool_name_pattern": "update_and_restart",
      "risk_level": "critical",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "代码更新并重启"
    },
    {
      "tool_name_pattern": "write_file",
      "risk_level": "high",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "trust_after_n_approvals": 3,
      "description": "文件写入（信任后免批准）"
    },
    {
      "tool_name_pattern": "delete_file",
      "risk_level": "high",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "文件删除"
    },
    {
      "tool_name_pattern": "move_file",
      "risk_level": "high",
      "requires_approval": true,
      "timeout_seconds": 60.0,
      "on_timeout": "deny",
      "description": "文件移动/重命名"
    },
    {
      "tool_name_pattern": "*__*",
      "risk_level": "medium",
      "requires_approval": true,
      "timeout_seconds": 45.0,
      "on_timeout": "deny",
      "description": "MCP 外部服务调用（MCP 工具命名为 <server>__<tool>）"
    },
    {
      "tool_name_pattern": "web_search",
      "risk_level": "low",
      "requires_approval": false,
      "description": "Web 搜索"
    },
    {
      "tool_name_pattern": "web_fetch",
      "risk_level": "low",
      "requires_approval": false,
      "description": "Web 页面读取"
    },
    {
      "tool_name_pattern": "*",
      "risk_level": "low",
      "requires_approval": false,
      "description": "默认低风险（兜底）"
    }
  ],
  "default_policy": {
    "tool_name_pattern": "*",
    "risk_level": "medium",
    "requires_approval": true,
    "timeout_seconds": 60.0,
    "on_timeout": "deny",
    "description": "未匹配任何策略时的默认行为"
  }
}
