{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "allowJs": true, "checkJs": true, "strict": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["*.cjs", "tests/*.cjs"]
}
